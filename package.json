{
  "name": "mjo-workshop-2026-portal",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "exports": {
    "./scientific-publication-policy": "./src/science/publication-policy.mjs"
  },
  "emdash": {
    "label": "Starter",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "dev:node": "astro dev --host 127.0.0.1 --config astro.config.node.mjs",
    "build": "node scripts/with-site-wrangler.mjs build npx astro build",
    "build:node": "astro build --config astro.config.node.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "start": "HOST=127.0.0.1 node --env-file=.env ./dist/server/entry.mjs",
    "deploy": "node scripts/with-site-wrangler.mjs deploy npx wrangler deploy",
    "cf:dev": "node scripts/with-site-wrangler.mjs local npx wrangler dev --ip 127.0.0.1 --port 8787",
    "typecheck": "astro check",
    "verify:local": "node scripts/verify-local.mjs",
    "test:science": "node --test tests/science.test.mjs",
    "test:security": "node --test tests/public-request-guard.test.mjs",
    "test:phase8": "node --test tests/phase8-relations.test.mjs",
    "science:validate": "node scripts/science.mjs validate",
    "science:plan": "node scripts/science.mjs plan",
    "science:check": "node scripts/science.mjs check-generated",
    "science:build-synthesis": "node scripts/build-personal-synthesis.mjs",
    "verify:phase4": "node scripts/verify-phase4-http.mjs",
    "verify:phase6": "node scripts/verify-phase6.mjs",
    "verify:phase8": "node scripts/verify-phase8.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^7.0.0",
    "@emdash-cms/cloudflare": "^1.4.0",
    "astro": "^7.3.2",
    "emdash": "^1.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.19.2",
    "node": "^24.22.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.157.0"
  },
  "overrides": {
    "emdash": {
      "zod": "4.6.7"
    },
    "@emdash-cms/auth": {
      "zod": "4.6.7"
    },
    "@emdash-cms/plugin-types": {
      "zod": "4.6.7"
    }
  },
  "engines": {
    "node": "^24.15.0"
  }
}
