---
// Directed graph of relations among the twelve workflows.
// Phase 10: every relation is typed (start / interpretation / publication / optional).
// Columns follow the longest chain of start- and interpretation-prerequisites, i.e.
// when a workflow's results can be interpreted; every workflow can start now.
import { DEPENDENCIES_V2, DEPENDENCY_TYPES } from "../science/phase10/roadmap.mjs";
const SHORT: Record<string, string> = {
	"action-q01": "Theory-comparison matrix", "action-q02": "Lifecycle labels", "action-q03": "Transition-phase budgets",
	"action-q04": "Energy diagnostics", "action-q05": "QBO–cloud–convection test", "action-q06": "Diagnostic audit",
	"action-q07": "Test AI explanations", "action-q08": "Matched forecast benchmark", "action-q09": "Passage-error diagnosis",
	"action-q10": "Independence register", "action-q11": "Conditional regional skill", "action-q12": "Trend audit",
};
type DepType = keyof typeof DEPENDENCY_TYPES;
const STYLE: Record<DepType, { stroke: string; width: number; dash?: string }> = {
	start: { stroke: "#8c3b1f", width: 2.2 },
	interpretation: { stroke: "#0b5048", width: 1.8 },
	publication: { stroke: "#5b4a8a", width: 1.6, dash: "9 4" },
	optional: { stroke: "#8a9a95", width: 1.2, dash: "2 4" },
};
const layering = DEPENDENCIES_V2.filter((d) => d.type === "start" || d.type === "interpretation");
const nodes = Object.keys(SHORT);
const level = new Map<string, number>();
const depth = (id: string, seen = new Set<string>()): number => {
	if (level.has(id)) return level.get(id)!;
	if (seen.has(id)) throw new Error(`dependency cycle at ${id}`);
	seen.add(id);
	const parents = layering.filter((d) => d.to === id).map((d) => d.from);
	const value = parents.length ? Math.max(...parents.map((p) => depth(p, new Set(seen)) + 1)) : 0;
	level.set(id, value);
	return value;
};
nodes.forEach((n) => depth(n));
const columns = Math.max(...level.values()) + 1;
const W = 300, H = 46, GAPX = 90, GAPY = 26, PAD = 20;
const byCol = Array.from({ length: columns }, (_, c) => nodes.filter((n) => level.get(n) === c));
const rows = Math.max(...byCol.map((c) => c.length));
const pos = new Map<string, { x: number; y: number }>();
byCol.forEach((col, c) => col.forEach((n, r) => pos.set(n, { x: PAD + c * (W + GAPX), y: PAD + 28 + r * (H + GAPY) + ((rows - col.length) * (H + GAPY)) / 2 })));
const width = PAD * 2 + columns * W + (columns - 1) * GAPX;
const height = PAD * 2 + 28 + rows * (H + GAPY);
const COL_TITLES = ["Interpretable on its own", "Interpretation needs one earlier result", "Interpretation needs two earlier results"];
const used = (Object.keys(DEPENDENCY_TYPES) as DepType[]).filter((t) => DEPENDENCIES_V2.some((d) => d.type === t));
---
<svg class="dep-graph" viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="dep-title dep-desc">
  <title id="dep-title">Research dependencies among the twelve workflows</title>
  <desc id="dep-desc">Boxes are workflows. Every workflow can start now; columns show how many earlier results its interpretation depends on. Solid dark arrows are prerequisites for interpretation, long-dashed arrows prerequisites for publication, dotted arrows helpful but optional relations. The same relations are listed as text below the graph.</desc>
  <defs>
    {(Object.keys(STYLE) as DepType[]).map((t) => <marker id={`arrow-${t}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill={STYLE[t].stroke} /></marker>)}
  </defs>
  {byCol.map((_, c) => <text x={PAD + c * (W + GAPX)} y={PAD + 8} font-size="13" font-weight="700" fill="#12695e">{COL_TITLES[c] ?? `Step ${c + 1}`}</text>)}
  {DEPENDENCIES_V2.map((d) => {
    const a = pos.get(d.from)!, b = pos.get(d.to)!;
    const t = d.type as DepType;
    const x1 = a.x + W, y1 = a.y + H / 2, x2 = b.x - 4, y2 = b.y + H / 2;
    const mx = (x1 + x2) / 2;
    const sameCol = level.get(d.from) === level.get(d.to);
    const down = b.y > a.y;
    const path = sameCol
      ? `M${a.x + W - 30} ${down ? a.y + H : a.y} C${a.x + W + 40} ${down ? a.y + H + 24 : a.y - 24} ${b.x + W + 40} ${down ? b.y - 24 : b.y + H + 24} ${b.x + W - 30} ${down ? b.y - 4 : b.y + H + 4}`
      : `M${x1} ${y1} C${mx} ${y1} ${mx} ${y2} ${x2} ${y2}`;
    return <path d={path} fill="none" stroke={STYLE[t].stroke} stroke-width={STYLE[t].width} stroke-dasharray={STYLE[t].dash} marker-end={`url(#arrow-${t})`} opacity="0.85" data-type={t} />;
  })}
  {nodes.map((n) => {
    const p = pos.get(n)!;
    return (
      <a href={`/actions/${n.replace("action-", "")}`}>
        <rect x={p.x} y={p.y} width={W} height={H} rx="4" fill="#ffffff" stroke="#9db5a5" />
        <text x={p.x + 12} y={p.y + 19} font-size="12" font-weight="700" fill="#12695e">{n.replace("action-", "").toUpperCase()}</text>
        <text x={p.x + 12} y={p.y + 36} font-size="14" fill="#172f3b">{SHORT[n]}</text>
      </a>
    );
  })}
</svg>
<ul class="dep-legend">
  {used.map((t) => <li><span class:list={["dep-swatch", `dep-${t}`]} aria-hidden="true"></span><strong>{DEPENDENCY_TYPES[t].label}</strong> ({DEPENDENCIES_V2.filter((d) => d.type === t).length}): {DEPENDENCY_TYPES[t].description}</li>)}
</ul>
