---
// Phase 9D: directed graph of prerequisite relations among the twelve workflows.
// Layout: column = longest chain of prerequisites leading to the workflow.
import { DEPENDENCIES } from "../science/phase9/roadmap.mjs";
const SHORT: Record<string, string> = {
	"action-q01": "Theory-comparison matrix", "action-q02": "Lifecycle labels", "action-q03": "Transition-phase budgets",
	"action-q04": "Energy diagnostics", "action-q05": "QBO–cloud–convection test", "action-q06": "Diagnostic audit",
	"action-q07": "Test AI explanations", "action-q08": "Matched forecast benchmark", "action-q09": "Passage-error diagnosis",
	"action-q10": "Independence register", "action-q11": "Conditional regional skill", "action-q12": "Trend audit",
};
const nodes = Object.keys(SHORT);
const level = new Map<string, number>();
const depth = (id: string, seen = new Set<string>()): number => {
	if (level.has(id)) return level.get(id)!;
	if (seen.has(id)) throw new Error(`dependency cycle at ${id}`);
	seen.add(id);
	const parents = DEPENDENCIES.filter((d) => d.to === id).map((d) => d.from);
	const value = parents.length ? Math.max(...parents.map((p) => depth(p, seen) + 1)) : 0;
	level.set(id, value);
	return value;
};
nodes.forEach((n) => depth(n));
const columns = Math.max(...level.values()) + 1;
const W = 300, H = 46, GAPX = 90, GAPY = 26, PAD = 20;
const byCol = Array.from({ length: columns }, (_, c) => nodes.filter((n) => level.get(n) === c));
const rows = Math.max(...byCol.map((c) => c.length));
const pos = new Map<string, { x: number; y: number }>();
byCol.forEach((col, c) => col.forEach((n, r) => pos.set(n, { x: PAD + c * (W + GAPX), y: PAD + 28 + r * (H + GAPY) + ((rows - col.length) * (H + GAPY)) / 2 })));
const width = PAD * 2 + columns * W + (columns - 1) * GAPX;
const height = PAD * 2 + 28 + rows * (H + GAPY);
const COL_TITLES = ["Can start now (no prerequisite)", "After foundations", "After benchmarks and budgets"];
---
<svg class="dep-graph" viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="dep-title dep-desc">
  <title id="dep-title">Research dependencies among the twelve workflows</title>
  <desc id="dep-desc">Boxes are workflows, arranged by how many prerequisite steps precede them. Solid arrows mark required prerequisites; dashed arrows mark helpful but not required ones. The same relations are listed as text below the graph.</desc>
  <defs>
    <marker id="arrow-req" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#0b5048" /></marker>
    <marker id="arrow-help" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#8a9a95" /></marker>
  </defs>
  {byCol.map((_, c) => <text x={PAD + c * (W + GAPX)} y={PAD + 8} font-size="13" font-weight="700" fill="#12695e">{COL_TITLES[c] ?? `Step ${c + 1}`}</text>)}
  {DEPENDENCIES.map((d) => {
    const a = pos.get(d.from)!, b = pos.get(d.to)!;
    const x1 = a.x + W, y1 = a.y + H / 2, x2 = b.x - 4, y2 = b.y + H / 2;
    const mx = (x1 + x2) / 2;
    const sameCol = level.get(d.from) === level.get(d.to);
    const path = sameCol ? `M${a.x + W / 2} ${a.y + H} C${a.x + W / 2} ${a.y + H + 20} ${b.x + W / 2} ${b.y - 20} ${b.x + W / 2} ${b.y - 4}` : `M${x1} ${y1} C${mx} ${y1} ${mx} ${y2} ${x2} ${y2}`;
    return <path d={path} fill="none" stroke={d.strength === "required" ? "#0b5048" : "#8a9a95"} stroke-width={d.strength === "required" ? 1.8 : 1.3} stroke-dasharray={d.strength === "required" ? undefined : "5 4"} marker-end={`url(#${d.strength === "required" ? "arrow-req" : "arrow-help"})`} opacity="0.85" />;
  })}
  {nodes.map((n) => {
    const p = pos.get(n)!;
    return (
      <a href={`/actions/${n.replace("action-", "")}`}>
        <rect x={p.x} y={p.y} width={W} height={H} rx="4" fill="#ffffff" stroke="#9db5a5" />
        <text x={p.x + 12} y={p.y + 19} font-size="12" font-weight="700" fill="#12695e">{n.replace("action-", "").toUpperCase()}</text>
        <text x={p.x + 12} y={p.y + 36} font-size="14" fill="#172f3b">{SHORT[n]}</text>
      </a>
    );
  })}
</svg>
<p class="small">Solid arrows: required before the next workflow's results can be interpreted as intended. Dashed arrows: helpful, but the next workflow can start in parallel.</p>
