---
interface Props { current: "program" | "video" | "question" | "action" }
const { current } = Astro.props;
const steps = [
  { key: "program", href: "/program#tue-breakout-3-4", label: "Program" },
  { key: "video", href: "/videos/breakout-themes-3-4", label: "Video Highlight" },
  { key: "question", href: "/questions/themes/q01", label: "Scientific Question" },
  { key: "action", href: "/actions/q01", label: "Research Action" },
];
---
<nav class="journey" aria-label="Explore this discussion">{steps.map((step, i) => <>{i > 0 && <span aria-hidden="true">→</span>}<a href={step.href} aria-current={current === step.key ? "page" : undefined}>{step.label}</a></>)}</nav>
