---
// Context path built from real relations; steps without a target render as text.
interface Step { label: string; href?: string; current?: boolean }
interface Props { steps: Step[]; label?: string }
const { steps, label = "Explore this topic" } = Astro.props;
---
<nav class="journey" aria-label={label}>{steps.map((step, i) => <>{i > 0 && <span aria-hidden="true">→</span>}{step.href && !step.current ? <a href={step.href}>{step.label}</a> : <span class:list={["journey-step", { current: step.current }]} aria-current={step.current ? "page" : undefined}>{step.label}</span>}</>)}</nav>
