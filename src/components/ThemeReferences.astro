---
import type { ThemeReview } from '../science/theme-review';
import { getEvidence, getSource, sourceLabel, sourceQualityOf, SOURCE_QUALITY, type EvidenceRecord, type SourceRecord } from '../science/phase8';
import { phase9Evidence, phase9Sources } from '../science/phase9/provenance.mjs';
const phase9Ids = new Set([...phase9Evidence.map(e => e.evidence_id), ...phase9Sources.map(s => s.source_id)]);
const quality = (id: string) => SOURCE_QUALITY[sourceQualityOf(id) as keyof typeof SOURCE_QUALITY];
interface Props { review: ThemeReview; ids: string[] }
const { review, ids } = Astro.props;
const evidence = [...new Set(ids)].map(getEvidence).filter((e): e is EvidenceRecord => !!e);
const sources = [...new Set(evidence.map(e => e.source_id))].map(getSource).filter((s): s is SourceRecord => !!s)
  .sort((a, b) => (a.session_date ?? '9999').localeCompare(b.session_date ?? '9999') || a.title.localeCompare(b.title));
const references = review.references.filter(r => ids.includes(r.id));
const dateLabel = (d: string | null) => d ? new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', timeZone: 'UTC' }) : 'Date not confirmed';
---
<section id="references" class="theme-references">
  <h2>Sources, provenance &amp; review</h2>
  <p class="small">Personal synthesis v{review.version} ({review.created_on}). Statements are selected and paraphrased by the author from converted minutes; no formal workshop consensus is established, and source coverage is partial.</p>
  {references.length > 0 && <>
    <h3>External scientific references</h3>
    {references.map(ref => <article id={ref.id}><h4><a href={ref.url}>{ref.title}</a></h4><p>{ref.scope}</p><p class="small">Definition or source checked {ref.verified_on}. This does not validate the surrounding synthesis.</p></article>)}
  </>}
  {sources.length > 0 && <>
    <h3>Workshop records cited ({sources.length})</h3>
    <p class="small">Each record is a private set of minutes kept offline; only edited paraphrases appear on this site. Discussion participants remain anonymous. Breakout, plenary and final-day records may describe the same discussion and are not independent votes.</p>
    <div class="source-list">{sources.map(source => <article id={source.source_id}><h4>{sourceLabel(source.source_id)}</h4><p class="small">{dateLabel(source.session_date)} · {source.attribution_mode === 'named_talk' ? 'Programme talk' : 'Discussion record (unattributed)'} · Coverage: {source.coverage} · Independent source review: {source.source_review_status === 'not_established' ? 'not established' : source.source_review_status.replaceAll('_', ' ')}{phase9Ids.has(source.source_id) && ' · added in Phase 9'}</p><p class="small"><span title={quality(source.source_id).description}>Record type: {quality(source.source_id).label}.</span> {source.limitations}</p></article>)}</div>
  </>}
  {evidence.length > 0 && <details><summary>Claim-level source locators ({evidence.length})</summary>
    <p class="small">Each identifier names a passage in a private record. Locators support editorial traceability; they are not a correctness proof and do not expose file hashes. Locators marked “supplied in Phase 8” were missing from the original public package; those marked “added in Phase 9” cite sections of the minutes first used in Phase 9.</p>
    <dl>{evidence.map(e => <div id={e.evidence_id}><dt>{e.evidence_id}</dt><dd>{sourceLabel(e.source_id)} · {e.locator} · lines {e.line_start}–{e.line_end}{e.supplemental && (phase9Ids.has(e.evidence_id) ? ' · added in Phase 9' : ' · supplied in Phase 8')}</dd></div>)}</dl>
  </details>}
</section>
<style>
.theme-references article{margin:1rem 0}.theme-references h3{margin-top:2rem}.theme-references h4{margin:0 0 .4rem;font-size:1rem}.theme-references details{margin:1.5rem 0}.theme-references summary{font-weight:600;padding:.5rem 0}.theme-references dl>div{border-top:1px solid var(--line);padding:1rem 0;scroll-margin-top:1rem}.theme-references dt{font-weight:650;font-size:.85rem}.theme-references dd{margin:.35rem 0;font-size:.85rem}.source-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,20rem),1fr));gap:.9rem}.source-list article{margin:0;padding:1.1rem;scroll-margin-top:1rem}.source-list p{margin-bottom:.4rem}
</style>
