---
import Base from "../layouts/Base.astro";
import HighlightCard from "../components/HighlightCard.astro";
import { SITE_TITLE, SUBTITLE, SITE_STANCE } from "../data/portal";
import { highlights } from "../data/highlights";
import { insights, allIssues, allActions, priorityAreas, issuesForVideo } from "../science/phase8";
const allApproved = insights().every((i) => i.approval);
const linkedClips = highlights.filter((h) => issuesForVideo(h.slug).length > 0).length;
---
<Base title={SITE_TITLE} description={SUBTITLE}>
  <section class="hero" aria-labelledby="portal-title">
    <div><p class="eyebrow">ICTP, Trieste · 26–30 October 2026</p><h1 id="portal-title">MJO Workshop 2026 — Knowledge &amp; Action Portal</h1><p class="lead">{SUBTITLE}</p><p class="muted">What did we learn, what remains contested, and what should we investigate next? Start with the synthesis, then follow the evidence into questions, talks and possible research.</p><p class="small">{SITE_STANCE.shortLabel} — not an official ICTP record. <a href="/about">About this report →</a></p><div class="buttons"><a class="button" href="/workshop-synthesis">Read the Workshop Synthesis <span aria-hidden="true">→</span></a><a class="button secondary" href="/program">Program &amp; Sessions</a><a class="button secondary" href="/videos">Video Highlights</a></div></div>
    <div class="hero-art" role="img" aria-label="Abstract wave illustration evoking tropical convection. Decorative artwork, not scientific data."><svg viewBox="0 0 460 380" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs><linearGradient id="wave" x1="0" x2="1"><stop stop-color="#277967" stop-opacity=".1"/><stop offset=".6" stop-color="#277967" stop-opacity=".6"/><stop offset="1" stop-color="#277967" stop-opacity=".2"/></linearGradient></defs><g stroke="#9db5a5" stroke-width=".5" opacity=".6"><path d="M0 90H460M0 150H460M0 210H460M0 270H460M90 0V380M180 0V380M270 0V380M360 0V380"/></g><g fill="none" stroke="url(#wave)" stroke-width="2"><path d="M-50 270C45 290 65 50 175 105S310 335 510 100"/><path d="M-50 278C45 298 65 58 175 113S310 343 510 108"/><path d="M-50 286C45 306 65 66 175 121S310 351 510 116"/><path d="M-50 294C45 314 65 74 175 129S310 359 510 124"/><path d="M-50 302C45 322 65 82 175 137S310 367 510 132"/><path d="M-50 310C45 330 65 90 175 145S310 375 510 140"/><path d="M-50 318C45 338 65 98 175 153S310 383 510 148"/><path d="M-50 326C45 346 65 106 175 161S310 391 510 156"/><path d="M-50 334C45 354 65 114 175 169S310 399 510 164"/><path d="M-50 342C45 362 65 122 175 177S310 407 510 172"/></g><circle cx="162" cy="117" r="35" fill="#c6d7a3" opacity=".55"/><circle cx="315" cy="264" r="54" fill="#9cbea8" opacity=".25"/><path d="M35 190H425" stroke="#285e4f" stroke-dasharray="4 5" opacity=".5"/></svg><div class="hero-art-caption"><span>Patterns · Processes · Prediction</span><span>Concept illustration</span></div></div>
  </section>
  <div class="meta-strip"><span>5 workshop days</span><span>6 program themes</span><span>{allIssues().length} scientific questions</span><span>{highlights.length} one-minute highlights ({linkedClips} linked to questions)</span><span>{priorityAreas().length} research areas · {allActions().length} workflows</span></div>

  <section aria-labelledby="ways-in"><div class="section-head"><h2 id="ways-in">Three ways into the workshop</h2></div><div class="card-grid">
    <article class="card goal-card"><span class="card-number">01</span><h3><a href="/workshop-synthesis">Understand the scientific outcomes</a></h3><p>{insights().length} insights, the disputes that remain open, four research areas and three candidate pilot projects, each linked to its evidence.</p><a href="/workshop-synthesis">Workshop Synthesis →</a></article>
    <article class="card goal-card"><span class="card-number">02</span><h3><a href="/videos">Explore supporting talks and highlights</a></h3><p>Follow the programme day by day, or watch one-minute highlights linked to the questions their talks inform.</p><a href="/videos">Video Highlights →</a> · <a href="/program">Program &amp; Sessions →</a></article>
    <article class="card goal-card"><span class="card-number">03</span><h3><a href="/actions">Investigate proposed future research</a></h3><p>Four strategic research areas built from the scientific questions, with testable hypotheses and illustrative workflows.</p><a href="/actions">Research Action Roadmap →</a></article>
  </div></section>

  <section aria-labelledby="path"><div class="section-head"><h2 id="path">From synthesis to action</h2></div>
    <ol class="progression">
      <li><a href="/workshop-synthesis"><strong>Workshop Synthesis</strong><span>What was learned and what remains open</span></a></li>
      <li><a href="/questions"><strong>Scientific Questions</strong><span>Twelve questions, with the evidence and how positions relate</span></a></li>
      <li><a href="/videos"><strong>Related Video Highlights</strong><span>One-minute clips from the talks and sessions whose minutes each question cites</span></a></li>
      <li><a href="/actions"><strong>Research Actions</strong><span>Objectives, hypotheses and possible workflows</span></a></li>
    </ol>
  </section>

  <section aria-labelledby="learned"><div class="section-head"><h2 id="learned">What we learned — at a glance</h2><a href="/workshop-synthesis#learned">Read the synthesis →</a></div>
    <ol class="glance">{insights().map((insight) => <li><a href={`/workshop-synthesis#${insight.id}`}>{insight.title}</a></li>)}</ol>
    <p class="small">{allApproved ? "Editorial synthesis of converted, ASR-derived minutes. Wording approved by the author on 5 November 2026 (editorial approval, not independent verification); not a workshop consensus." : "Editorial synthesis of converted, ASR-derived minutes (Phase 9 draft, awaiting the author's review); not a workshop consensus."}</p>
  </section>

  <section><div class="section-head"><h2>A moment from the discussion</h2><a href="/videos">All highlights →</a></div><HighlightCard /></section>
  <section><div class="section-head"><h2>Explore by topic</h2></div><div class="card-grid"><article class="card topic-card"><p class="eyebrow">Topic / 01</p><h2><a href="/ai-for-mjo-research">AI for MJO Research</a></h2><p>Forecast skill, physical consistency and explainability across workshop sessions.</p></article><article class="card topic-card"><p class="eyebrow">Topic / 02</p><h2><a href="/mjo-indices-and-diagnostics">MJO Indices and Diagnostics</a></h2><p>RMM, OMI, ROMI and related diagnostics, with definitions kept distinct.</p></article><article class="card topic-card"><p class="eyebrow">By date</p><h2><a href="/program">Program &amp; Sessions</a></h2><p>The five-day timetable in chronological order, with highlights in place.</p></article></div></section>
</Base>
<style>
.goal-card .card-number{margin-bottom:.6rem}
.progression{list-style:none;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:0;counter-reset:prog;margin:0}.progression li{counter-increment:prog;margin:0;position:relative}.progression a{display:flex;flex-direction:column;gap:.35rem;height:100%;padding:1.1rem 1.3rem 1.2rem 1.3rem;background:#fff;border:1px solid var(--line);text-decoration:none;color:var(--ink)}.progression li+li a{border-left:0}.progression a:before{content:counter(prog,decimal-leading-zero);font-family:var(--serif);color:var(--teal);font-size:1.2rem}.progression li:not(:last-child):after{content:"→";position:absolute;right:-.55rem;top:50%;transform:translateY(-50%);z-index:2;background:var(--paper);color:var(--teal);font-weight:700;padding:0 .1rem}.progression span{font-size:.84rem;color:var(--muted)}.progression a:hover{background:#f0f5f0}
.glance{columns:2 22rem;column-gap:2.5rem;padding-left:1.3rem;margin:0}.glance li{break-inside:avoid;margin:0 0 .6rem}.glance a{color:var(--ink)}
@media(max-width:820px){.progression{grid-template-columns:1fr 1fr}.progression li+li a{border-left:1px solid var(--line)}.progression li:after{display:none}}
@media(max-width:520px){.progression{grid-template-columns:1fr}}
</style>
