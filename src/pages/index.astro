---
import Base from "../layouts/Base.astro";
import HighlightCard from "../components/HighlightCard.astro";
import { SITE_TITLE, SUBTITLE } from "../data/portal";
---
<Base title={SITE_TITLE} description={SUBTITLE}>
  <section class="hero" aria-labelledby="portal-title">
    <div><p class="eyebrow">ICTP, Trieste · 26–30 October 2026</p><h1 id="portal-title">MJO Workshop 2026 — Knowledge &amp; Action Portal</h1><p class="lead">{SUBTITLE}</p><p class="muted">Revisit the conversations. Connect the questions. Explore possible next steps for MJO research.</p><div class="buttons"><a class="button" href="/program">Explore the program <span aria-hidden="true">→</span></a><a class="button secondary" href="/videos">Watch highlights</a></div></div>
    <div class="hero-art" role="img" aria-label="Abstract wave illustration evoking tropical convection. Decorative artwork, not scientific data."><svg viewBox="0 0 460 380" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs><linearGradient id="wave" x1="0" x2="1"><stop stop-color="#277967" stop-opacity=".1"/><stop offset=".6" stop-color="#277967" stop-opacity=".6"/><stop offset="1" stop-color="#277967" stop-opacity=".2"/></linearGradient></defs><g stroke="#9db5a5" stroke-width=".5" opacity=".6"><path d="M0 90H460M0 150H460M0 210H460M0 270H460M90 0V380M180 0V380M270 0V380M360 0V380"/></g><g fill="none" stroke="url(#wave)" stroke-width="2"><path d="M-50 270C45 290 65 50 175 105S310 335 510 100"/><path d="M-50 278C45 298 65 58 175 113S310 343 510 108"/><path d="M-50 286C45 306 65 66 175 121S310 351 510 116"/><path d="M-50 294C45 314 65 74 175 129S310 359 510 124"/><path d="M-50 302C45 322 65 82 175 137S310 367 510 132"/><path d="M-50 310C45 330 65 90 175 145S310 375 510 140"/><path d="M-50 318C45 338 65 98 175 153S310 383 510 148"/><path d="M-50 326C45 346 65 106 175 161S310 391 510 156"/><path d="M-50 334C45 354 65 114 175 169S310 399 510 164"/><path d="M-50 342C45 362 65 122 175 177S310 407 510 172"/></g><circle cx="162" cy="117" r="35" fill="#c6d7a3" opacity=".55"/><circle cx="315" cy="264" r="54" fill="#9cbea8" opacity=".25"/><path d="M35 190H425" stroke="#285e4f" stroke-dasharray="4 5" opacity=".5"/></svg><div class="hero-art-caption"><span>Patterns · Processes · Prediction</span><span>Concept illustration</span></div></div>
  </section>
  <div class="meta-strip"><span>5 workshop days</span><span>6 program themes</span><span>1 supplied video highlight</span><span>Scientific summaries under review</span></div>
  <section><div class="section-head"><h2>Two ways into the workshop</h2></div><div class="card-grid"><article class="card"><span class="card-number">01</span><h3><a href="/program">Follow the conversations</a></h3><p>Browse sessions chronologically, from global observations to theory, prediction and the final plenary.</p><a href="/program">Program &amp; Sessions →</a></article><article class="card"><span class="card-number">02</span><h3><a href="/questions">Follow the questions</a></h3><p>Explore the spaces for scientific questions, perspectives and emerging alignment across sessions.</p><a href="/questions">Scientific Questions →</a></article></div></section>
  <section><div class="section-head"><h2>A moment from the discussion</h2><a href="/videos">All highlights →</a></div><HighlightCard /></section>
  <section><div class="section-head"><h2>Explore by topic</h2></div><div class="card-grid"><article class="card topic-card"><p class="eyebrow">Topic / 01</p><h2><a href="/ai-for-mjo-research">AI for MJO Research</a></h2><p>Questions, evidence and possible workflows. Reviewed content in preparation.</p></article><article class="card topic-card"><p class="eyebrow">Topic / 02</p><h2><a href="/mjo-indices-and-diagnostics">MJO Indices and Diagnostics</a></h2><p>Definitions, measurement and evaluation. Reviewed content in preparation.</p></article><article class="card topic-card"><p class="eyebrow">Questions into methods</p><h2><a href="/actions">Research Action Roadmap</a></h2><p>Illustrative AI agent workflows for future consideration. No formal commitments.</p></article></div></section>
  <div class="notice"><strong>A portal with visible uncertainty.</strong> The program and sample video's session mapping are verified. Scientific summaries, question classifications and publication permissions remain under review. <a href="/about">About the methodology →</a></div>
</Base>
