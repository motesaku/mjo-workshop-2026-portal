---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import ScienceNavigation from "../components/ScienceNavigation.astro";
import { CLASSIFICATIONS } from "../science/contract.mjs";
import { loadThemeReview, CLASSIFICATION_ROUTES } from "../science/theme-review";
import { SITE_STANCE } from "../data/portal";
const review = loadThemeReview();
const issues = review?.issues ?? [];
---
<Base title="Scientific Questions">
  <PageIntro title="Scientific Questions" eyebrow="Follow the ideas across sessions" description="Twelve cross-session questions from a personal reading of converted workshop minutes, linked to evidence locators and illustrative research actions." />
  <ScienceNavigation />
  <div class="notice" data-theme-review="personal-report"><strong>{SITE_STANCE.shortLabel}.</strong> These questions are a personal synthesis. Classifications are provisional editorial labels, not workshop votes. Formal consensus is not established.</div>
  <div class="card-grid">
    {issues.map(issue => (
      <article class="card">
        <p class="eyebrow">{issue.id} · {issue.classification}</p>
        <span class="badge draft">Personal synthesis</span>
        <h2 style="margin-top:1rem"><a href={`/questions/themes/${issue.id}`}>{issue.title}</a></h2>
        <p>{issue.question}</p>
        <p class="small"><a href={CLASSIFICATION_ROUTES[issue.classification] ?? '/questions'}>{issue.classification}</a> · Coverage: {issue.coverage}</p>
        <a href={`/questions/themes/${issue.id}`}>Open the issue →</a>
      </article>
    ))}
  </div>
  <section><h2>How these questions are classified</h2><p>These are editorial definitions used in this personal report.</p><dl class="method-list">{Object.values(CLASSIFICATIONS).map(({label, description}) => <><dt>{label}</dt><dd>{description}</dd></>)}</dl></section>
</Base>
