---
import Base from '../../../layouts/Base.astro';
import PageIntro from '../../../components/PageIntro.astro';
import ThemeReferences from '../../../components/ThemeReferences.astro';
import { loadThemeReview, themeRoutes, textField, getAction, CLASSIFICATION_ROUTES } from '../../../science/theme-review';
import { SITE_STANCE } from '../../../data/portal';
const review = loadThemeReview();
const issue = review?.issues.find(q => q.id === Astro.params.issue);
if (!review || !issue) return Astro.rewrite('/404');
Astro.response.headers.set('Cache-Control', 'no-store');
const refs = [...new Set([
  ...issue.records.flatMap(c => c.evidence_ids),
  ...(issue.positions ?? []).flatMap(c => c.evidence_ids ?? []),
])];
const action = getAction(issue.id);
const classHref = CLASSIFICATION_ROUTES[issue.classification] ?? '/questions';
const comparison = textField(issue.comparison);
const alignment = textField(issue.emerging_alignment);
const unresolvedItems = Array.isArray(issue.unresolved_questions)
  ? issue.unresolved_questions.map((item) => item.text ?? "").filter(Boolean)
  : textField(issue.unresolved_questions) ? [textField(issue.unresolved_questions)] : [];
const limitations = textField(issue.limitations);
---
<Base title={issue.title} description={issue.question}>
  <PageIntro title={issue.title} eyebrow={`${issue.id} / Cross-session scientific issue`} description={issue.question} />
  <div class="notice" data-theme-review="personal-report"><strong>{SITE_STANCE.shortLabel}.</strong><p>{issue.status}. Provisional classification: {issue.classification}. Coverage: {issue.coverage}. Formal consensus is not established.</p></div>
  <p class="small"><a href={classHref}>← {issue.classification}</a> · <a href="/questions">All scientific questions</a>{action && <> · <a href={`/actions/${issue.id}`}>Illustrative research action</a></>}</p>

  <section><h2>Workshop record</h2><p>Edited paraphrases from converted minutes, selected for this personal report. Overlapping records are retained; they are not independent replications.</p>{issue.records.map(c => <article><p>{c.text}</p><p class="small">{c.claim_id} · {c.origin} · personal synthesis</p><nav class="subnav" aria-label={`Sources for ${c.claim_id}`}>{c.evidence_ids.map(id => <a href={`#${id}`}>{id}</a>)}</nav></article>)}</section>

  {issue.positions && issue.positions.length > 0 && <section><h2>Positions in dialogue</h2>{issue.positions.map(c => <article><p>{c.text}</p><p class="small">{c.claim_id} · {c.origin}</p></article>)}</section>}
  {comparison && <section><h2>Editorial comparison</h2><p>{comparison}</p></section>}
  {alignment && <section><h2>Emerging alignment (provisional)</h2><p>{alignment}</p></section>}
  {unresolvedItems.length > 0 && <section><h2>Unresolved questions</h2><ul>{unresolvedItems.map((text) => <li>{text}</li>)}</ul></section>}
  {limitations && <section><h2>Limitations</h2><p>{limitations}</p></section>}

  {action && <section><h2>Illustrative research action</h2><p class="small">Not a commitment, assignment or claim of completed work.</p><article class="card"><h3><a href={`/actions/${issue.id}`}>{action.title}</a></h3><p>{action.rationale}</p><a href={`/actions/${issue.id}`}>Open the workflow sketch →</a></article></section>}

  <section><h2>Explore the connected scientific themes</h2><div class="card-grid">{review.themes.filter(t => t.issues.includes(issue.id)).map(t => <article><h3><a href={themeRoutes[t.id]}>{t.title}</a></h3><p>{t.description}</p><a href={`${themeRoutes[t.id]}#testable-actions`}>See related theme material →</a></article>)}</div>
  {review.themes.every(t => !t.issues.includes(issue.id)) && <p class="small">This issue is part of the personal synthesis catalogue; it is not yet attached to a dedicated theme page.</p>}
  </section>
  <ThemeReferences review={review} ids={refs} />
</Base>
<style>section>article{margin-top:1rem}</style>
