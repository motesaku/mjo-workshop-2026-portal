---
import Base from '../../../layouts/Base.astro';
import PageIntro from '../../../components/PageIntro.astro';
import ContextNote from '../../../components/ContextNote.astro';
import ClaimEntry from '../../../components/ClaimEntry.astro';
import RelatedVideos from '../../../components/RelatedVideos.astro';
import ThemeReferences from '../../../components/ThemeReferences.astro';
import RelationshipBadge from '../../../components/RelationshipBadge.astro';
import DivergenceAnalysis from '../../../components/DivergenceAnalysis.astro';
import AlignmentAnalysis from '../../../components/AlignmentAnalysis.astro';
import { loadThemeReview, themeRoutes, CLASSIFICATION_ROUTES } from '../../../science/theme-review';
import { actionsForIssue, issueSignificance, phase8Label, videosForIssue, withheldForIssue, sourceLabel, divergenceAnalysis, alignmentAnalysis, disagreementVerdict, VERDICT_LABELS, type Claim } from '../../../science/phase8';
import { issueClaims, proposalClaims } from '../../../science/phase8/relations.mjs';
const review = loadThemeReview();
const issue = review?.issues.find(q => q.id === Astro.params.issue);
if (!review || !issue) return Astro.rewrite('/404');
Astro.response.headers.set('Cache-Control', 'no-store');
const asClaim = (value: unknown) => (value && typeof value === 'object' && 'claim_id' in value ? value as Claim : null);
const comparison = asClaim(issue.comparison);
const alignment = asClaim(issue.emerging_alignment);
const limitations = asClaim(issue.limitations);
const unresolved = (Array.isArray(issue.unresolved_questions) ? issue.unresolved_questions : [issue.unresolved_questions]).map(asClaim).filter((c): c is Claim => !!c);
const refs = [...new Set(([...issueClaims(issue), ...proposalClaims(issue)] as { claim: Claim }[]).flatMap(row => row.claim.evidence_ids ?? []))];
const actions = actionsForIssue(issue.id);
const videos = videosForIssue(issue.id);
const withheld = withheldForIssue(issue.id);
const why = issueSignificance(issue.id);
const draft = phase8Label();
const classHref = CLASSIFICATION_ROUTES[issue.classification] ?? '/questions';
const primaryAction = actions.find(a => a.relation === 'primary')?.action;
const divergence = divergenceAnalysis(issue.id);
const alignmentView = alignmentAnalysis(issue.id);
---
<Base title={issue.title} description={issue.question}>
  <PageIntro title={issue.title} eyebrow={`${issue.id.toUpperCase()} · Cross-session scientific question`} description={issue.question} />
  <ContextNote><a href={classHref}>{issue.classification}</a> (provisional editorial class) · Coverage: {issue.coverage}. Paraphrased from converted minutes; not a workshop consensus.</ContextNote>
  <nav class="subnav" aria-label="On this page"><a href="#why">Why it matters</a>{divergence ? <a href="#analysis">Structure of the difference</a> : <a href="#record">Workshop record</a>}{alignmentView && <a href="#alignment">Emerging alignment</a>}<a href="#videos">Video evidence</a><a href="#actions">Research actions</a><a href="#references">Sources</a></nav>

  {why && <section id="why"><h2>Why it matters</h2><p class="lead-sm">{why.text}</p><p class="small"><span class="tag">Editorial synthesis</span> {draft.long}</p></section>}

  {!divergence && <section id="relationship"><h2>How the positions relate</h2><p class="eyebrow">{VERDICT_LABELS[disagreementVerdict(issue.id)]}</p><RelationshipBadge issueId={issue.id} withNote /><p class="small"><span class="tag">Editorial synthesis</span> {draft.short}. Subcategories are defined on the <a href="/questions#classification">Scientific Questions</a> page.</p></section>}

  {divergence ? <DivergenceAnalysis issue={issue} /> : <>
  <section id="record"><h2>Workshop record</h2><p class="small">Edited paraphrases from converted minutes, selected for this personal report. Overlapping records are retained; they are not independent replications.</p>{issue.records.map(c => <ClaimEntry claim={c as Claim} />)}</section>

  {issue.positions && issue.positions.length > 0 && <section id="positions"><h2>Positions in dialogue</h2><p class="small">Positions are described without attribution to individual discussion participants.</p>{issue.positions.map(c => <ClaimEntry claim={c as Claim} />)}</section>}
  {comparison && <section id="comparison"><h2>Editorial comparison</h2><ClaimEntry claim={comparison} /></section>}
  {alignmentView ? <AlignmentAnalysis issue={issue} /> : alignment && <section id="alignment"><h2>Emerging alignment (provisional)</h2><ClaimEntry claim={alignment} /></section>}
  {unresolved.length > 0 && <section id="unresolved"><h2>Unresolved questions</h2>{unresolved.map(c => <ClaimEntry claim={c} />)}</section>}
  {limitations && !alignmentView && <section id="limitations"><h2>Limitations</h2><ClaimEntry claim={limitations} /></section>}
  </>}
  {divergence && alignment && <section id="alignment"><h2>Emerging alignment (provisional)</h2><ClaimEntry claim={alignment} /></section>}

  <section id="videos">
    <h2>Related video highlights</h2>
    <p class="small">A clip is listed when this question cites the minutes of the same talk or session. The one-minute clip itself was not checked against these statements.</p>
    {videos.length > 0 ? <RelatedVideos links={videos} context={issue.id.toUpperCase()} /> : <p>No clip is linked: the minutes cited here cannot yet be tied to a specific highlight.</p>}
    {withheld.length > 0 && <details class="withheld"><summary>Records cited here but not linked to a clip ({withheld.length})</summary><ul>{withheld.map(w => <li><strong>{sourceLabel(w.sourceId)}.</strong> {w.reason}</li>)}</ul></details>}
  </section>

  <section id="actions">
    <h2>Research actions</h2>
    <p class="small">Illustrative workflows suggested by this report. Not commitments, assignments or completed work.</p>
    <div class="card-grid">
      {actions.map(link => <article class="card"><p class="eyebrow">{link.relation === 'primary' ? 'Primary workflow' : `Also informs ${issue.id.toUpperCase()} · editorial cross-link`}</p><h3><a href={`/actions/${link.action.issue_id}`}>{link.action.title}</a></h3><p>{link.relation === 'primary' ? link.action.rationale : link.rationale}</p><a href={`/actions/${link.action.issue_id}`}>Open the workflow →</a></article>)}
    </div>
  </section>

  <section id="themes"><h2>Connected scientific themes</h2><div class="card-grid">{review.themes.filter(t => t.issues.includes(issue.id)).map(t => <article><h3><a href={themeRoutes[t.id]}>{t.title}</a></h3><p>{t.description}</p><a href={`${themeRoutes[t.id]}#testable-actions`}>See related theme material →</a></article>)}</div>
  {review.themes.every(t => !t.issues.includes(issue.id)) && <p class="small">This question is not yet attached to a dedicated theme page. {primaryAction && <a href="/actions">See where it sits in the research roadmap →</a>}</p>}
  </section>
  <ThemeReferences review={review} ids={refs} />
</Base>
<style>section>.claim{margin-top:1rem}</style>
