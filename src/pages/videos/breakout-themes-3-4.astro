---
import Base from "../../layouts/Base.astro";
import PageIntro from "../../components/PageIntro.astro";
import Journey from "../../components/Journey.astro";
import YouTubePlayer from "../../components/YouTubePlayer.astro";
import { highlight, PROGRAM_URL, VERIFIED_ON } from "../../data/portal";
---
<Base title={highlight.title} description="A one-minute highlight from the 27 October breakout on Themes 3 + 4. Scientific summary awaiting review.">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/videos">Video Highlights</a><span>/</span><span>Themes 3 + 4</span></nav>
  <PageIntro title={highlight.title} eyebrow="Video highlight / 01" description="Theory & Mechanisms · Modeling"><span class="badge">Session mapping verified</span> <span class="badge draft">Scientific review pending</span></PageIntro>
  <Journey current="video" />
  <div class="content-columns"><div class="reading">
    <YouTubePlayer id={highlight.youtubeId} title={highlight.youtubeTitle} />
    <p class="small">{highlight.duration} · Highlight · Unlisted · English metadata</p>
    <section><h2>Scientific summary</h2><div class="empty-state"><span class="badge draft">Awaiting review</span><p style="margin-top:1rem">A scientific summary has not been approved. The clip is associated with the theory and modeling breakout according to its title and the official program. No scientific conclusion is inferred from that association.</p></div></section>
    <section><h2>Key discussion points</h2><p>Reviewed discussion points are not available yet. The video's description is not used as a substitute for reviewed meeting minutes. Source coverage and uncertainties will accompany the approved summary.</p></section>
    <section><h2>Related scientific questions</h2><article class="card"><span class="badge draft">Navigation placeholder</span><h3 style="margin-top:1rem"><a href="/questions/theory-and-modelling">Theory &amp; modeling — question awaiting review</a></h3><p>No scientific question has been reconstructed or attributed to a participant.</p><a href="/questions/theory-and-modelling">Continue to the draft question →</a></article></section>
    <section><h2>Relevant research actions</h2><p>Scientific links to research actions await review. Preview the illustrative workflow interface for this discussion.</p><a href="/actions/theory-and-modelling">Explore the draft research workflow →</a></section>
  </div><aside aria-label="Session information"><h2>Session information</h2><dl class="metadata"><dt>Official session</dt><dd>Breakout Group Discussions — Themes 3 + 4</dd><dt>Date</dt><dd><time datetime="2026-10-27">{highlight.date}</time></dd><dt>Session time</dt><dd>{highlight.time}<br />Europe/Rome · CET (UTC+01:00)</dd><dt>Video duration</dt><dd>{highlight.duration} (60 seconds)</dd><dt>Record coverage</dt><dd>Partial — one-minute derivative</dd><dt>Public website permission</dt><dd>Pending verification</dd><dt>Metadata checked</dt><dd>{VERIFIED_ON}</dd></dl><div class="buttons"><a href="/program#tue-breakout-3-4">View in the program →</a></div></aside></div>
  <section><h2>Source &amp; mapping note</h2><p>{highlight.mappingBasis}</p><p class="small"><a href={PROGRAM_URL} target="_blank" rel="noopener noreferrer">Official ICTP timetable ↗</a> · <a href={`https://www.youtube.com/watch?v=${highlight.youtubeId}`} target="_blank" rel="noopener noreferrer">YouTube title, description and duration ↗</a></p><p class="small">Video title: {highlight.youtubeTitle}. Scientific source identifiers, versions and review records will be displayed when approved derivatives are available. No individual speaker attribution is assigned to this discussion.</p></section>
</Base>
