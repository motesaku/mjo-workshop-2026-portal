---
import Base from "../layouts/Base.astro";
import ContextNote from "../components/ContextNote.astro";
import ClaimEntry from "../components/ClaimEntry.astro";
import RelatedVideos from "../components/RelatedVideos.astro";
import RelationshipBadge from "../components/RelationshipBadge.astro";
import ThemeReferences from "../components/ThemeReferences.astro";
import { loadThemeReview } from "../science/theme-review";
import {
	SYNTHESIS_INTRO, EXECUTIVE_SYNTHESIS, INTERPRETATION_TYPES, insights, contestedTopics, priorityAreas, areaIssueIds,
	basisClaims, basisSourceLabels, videosForClaims, videosForIssues, getIssue, actionForIssue, phase8Label,
	disagreementVerdict, VERDICT_LABELS, ROADMAP_STATUS,
} from "../science/phase8";
const draft = phase8Label();
const areas = priorityAreas();
const sourceList = (ids: string[]) => basisSourceLabels(ids).map((s) => s.label).join("; ");
const review = loadThemeReview();
const allBasis = [...EXECUTIVE_SYNTHESIS.basis, ...insights().flatMap((i) => i.basis), ...contestedTopics().flatMap((t) => t.basis)];
const refIds = [...new Set([...allBasis.filter((id) => id.startsWith("e-")), ...basisClaims(allBasis).flatMap((row) => row.claim.evidence_ids ?? [])])];
---
<Base title={SYNTHESIS_INTRO.title} description={SYNTHESIS_INTRO.description}>
  <div class="page-intro synthesis-intro">
    <p class="eyebrow">Scientific overview · MJO Workshop 2026</p>
    <h1>{SYNTHESIS_INTRO.title}</h1>
    <p class="synthesis-subtitle">{SYNTHESIS_INTRO.subtitle}</p>
    <p class="lead">{SYNTHESIS_INTRO.description}</p>
  </div>
  <ContextNote>An independent synthesis by one participant from converted minutes. Not an official ICTP workshop report or a multi-author consensus.</ContextNote>
  <nav class="synthesis-nav" aria-label="Sections of the synthesis">
    <a href="#learned"><span>A</span>What did we learn?</a>
    <a href="#contested"><span>B</span>What remains contested or unresolved?</a>
    <a href="#next"><span>C</span>What should we investigate next?</a>
  </nav>

  <section id="executive" class="executive">
    <h2>In brief</h2>
    <p class="executive-text">{EXECUTIVE_SYNTHESIS.text}</p>
    <p class="small"><span class="tag">Editorial synthesis</span> {draft.long} Draws on {basisSourceLabels(EXECUTIVE_SYNTHESIS.basis).length} workshop records across the twelve <a href="/questions">scientific questions</a>.</p>
  </section>

  <section id="learned">
    <p class="eyebrow">Section A</p>
    <h2>What did we learn?</h2>
    <p class="lead-sm">Seven insights that recur in the reviewed records. Each states its evidence basis, the kind of statement it is, and how far it has been checked.</p>
    <ol class="insights">
      {insights().map((insight) => {
        const videos = videosForClaims(insight.basis);
        return (
          <li id={insight.id} class="insight">
            <h3>{insight.title}</h3>
            <p>{insight.text}</p>
            <dl class="provenance">
              <dt>Evidence basis</dt><dd>{sourceList(insight.basis)}</dd>
              <dt>Interpretation type</dt><dd>{INTERPRETATION_TYPES[insight.type].label}{insight.type === "workshop_record" ? " (paraphrased and condensed in Phase 8)" : " built on workshop records"}</dd>
              <dt>Review status</dt><dd>Underlying records: personal synthesis, source check pending. This wording: {draft.short}.</dd>
              <dt>Questions</dt><dd>{insight.issues.map((id, i) => <>{i > 0 && " · "}<a href={`/questions/themes/${id}`}>{id.toUpperCase()} · {getIssue(id)?.title}</a></>)}</dd>
            </dl>
            {videos.length > 0 && <RelatedVideos links={videos} context="this insight" limit={3} />}
            <details class="nested"><summary>Underlying statements ({insight.basis.length})</summary>{basisClaims(insight.basis).map((row) => <ClaimEntry claim={row.claim} context={row.issueId.toUpperCase()} />)}</details>
          </li>
        );
      })}
    </ol>
  </section>

  <section id="contested">
    <p class="eyebrow">Section B</p>
    <h2>What remains contested or unresolved?</h2>
    <p class="lead-sm">Genuine disagreement is distinguished from approaches that serve different purposes. Labels: <strong>A</strong> competing hypotheses and <strong>B</strong> different evaluation standards count as disagreement; <strong>C</strong> complementary perspectives does not. <a href="/questions#classification">Definitions →</a></p>
    <div class="contested">
      {contestedTopics().map((topic) => (
        <article id={topic.id} class="contested-topic">
          <h3>{topic.title}</h3>
          <p>{topic.text}</p>
          <ul class="contested-issues">
            {topic.issues.map((id) => <li><a href={`/questions/themes/${id}`}>{id.toUpperCase()} · {getIssue(id)?.title}</a><span class="small"> — {VERDICT_LABELS[disagreementVerdict(id)]}</span><RelationshipBadge issueId={id} /></li>)}
          </ul>
          <p class="small"><span class="tag">Editorial synthesis</span> Evidence basis: {sourceList(topic.basis)}. {draft.short}.</p>
        </article>
      ))}
    </div>
  </section>

  <section id="next">
    <p class="eyebrow">Section C</p>
    <h2>What should we investigate next?</h2>
    <p class="lead-sm">Four strategic research areas, defined by the scientific questions they address. {ROADMAP_STATUS}</p>
    <div class="next-areas">
      {areas.map((area) => {
        const videos = videosForIssues(area.coreIssues);
        return (
          <article id={`next-${area.id}`} class="next-area">
            <p class="eyebrow">Area {area.numeral} · {area.coreIssues.map((q) => q.toUpperCase()).join(", ")}{area.crossCuttingIssues.length > 0 && ` (+ ${area.crossCuttingIssues.map((q) => q.toUpperCase()).join(", ")})`}</p>
            <h3><a href={`/actions#${area.id}`}>{area.title}</a></h3>
            <dl class="chain-list">
              <dt>Scientific objective</dt><dd>{area.objective}</dd>
              <dt>Critical knowledge gap</dt><dd>{area.gap.text}</dd>
              <dt>A feasible next investigation</dt><dd>{area.nextInvestigation.text}</dd>
              <dt>Expected deliverable</dt><dd>{area.deliverable.text}</dd>
            </dl>
            <p class="small">Detailed workflows: {areaIssueIds(area).map((id, i) => { const a = actionForIssue(id); return a && <>{i > 0 && " · "}<a href={`/actions/${a.issue_id}`}>{a.title}</a></>; })}</p>
            {videos.length > 0 && <RelatedVideos links={videos} context="this area's questions" limit={2} />}
          </article>
        );
      })}
    </div>
    <p class="small"><span class="tag">New research proposal</span> Proposed investigations are suggestions in this report, not an official workshop action plan. No experiment has been executed.</p>
  </section>

  <section id="method">
    <h2>How this synthesis was made</h2>
    <p>Statements come from the author's English paraphrases of ASR-derived minutes for the talks and discussions listed in the <a href="/program">programme</a>. Phase 8 wording condenses those statements; every item lists the records it rests on, and detailed identifiers remain in the expandable sections. Overlapping breakout, plenary and closing records are not counted as independent support. Video highlights are linked only where a statement cites the minutes of the same talk or session; the clips themselves were not checked against the statements.</p>
    <p><a href="/about#reading-labels">How to read the labels →</a> · <a href="/questions">All scientific questions →</a> · <a href="/actions">Research Action Roadmap →</a></p>
  </section>
  {review && <ThemeReferences review={review} ids={refIds} />}
</Base>
<style>
.synthesis-subtitle{font-family:var(--serif);font-size:clamp(1.3rem,2.4vw,1.75rem);color:var(--teal-dark);margin:-.4rem 0 1rem;max-width:40ch}
.synthesis-nav{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,15rem),1fr));gap:.6rem;margin:1.6rem 0}.synthesis-nav a{display:flex;gap:.8rem;align-items:baseline;padding:.9rem 1rem;background:#fff;border:1px solid var(--line);border-top:3px solid var(--teal);text-decoration:none;color:var(--ink);font-weight:600;font-size:.92rem}.synthesis-nav span{font-family:var(--serif);font-size:1.3rem;color:var(--teal)}
.executive{background:#fff;border:1px solid var(--line);padding:1.6rem 1.8rem}.executive h2{font-size:1.4rem}.executive-text{font-family:var(--serif);font-size:1.18rem;line-height:1.6;max-width:72ch}
.insights{list-style:none;padding:0;counter-reset:ins;margin:1.4rem 0 0}.insight{counter-increment:ins;position:relative;padding:1.6rem 0 1.6rem 3.4rem;border-top:1px solid var(--line);margin:0;scroll-margin-top:1rem}.insight:before{content:counter(ins);position:absolute;left:0;top:1.4rem;font-family:var(--serif);font-size:2rem;color:var(--teal);line-height:1}.insight h3{font-family:var(--serif);font-weight:400;font-size:1.45rem;margin-bottom:.7rem}.insight>p{max-width:78ch}
.provenance{display:grid;grid-template-columns:max-content 1fr;gap:.25rem 1rem;font-size:.82rem;margin:.8rem 0;max-width:78ch}.provenance dt{color:var(--muted);font-weight:650}.provenance dd{margin:0}
.contested{display:grid;gap:1rem;margin-top:1.2rem}.contested-topic{padding:1.4rem 1.6rem;scroll-margin-top:1rem}.contested-topic h3{font-size:1.15rem}.contested-issues{list-style:none;padding:0;margin:.8rem 0}.contested-issues li{border-top:1px solid var(--line);padding:.55rem 0;margin:0}.contested-issues .relationship{margin:.3rem 0 0}
.next-areas{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,30rem),1fr));gap:1rem;margin-top:1.2rem}.next-area{border-top:3px solid var(--teal);scroll-margin-top:1rem}.next-area h3{font-family:var(--serif);font-weight:400;font-size:1.35rem}.next-area h3 a{color:var(--ink);text-decoration:none}
@media(max-width:640px){.insight{padding-left:2.4rem}.insight:before{font-size:1.6rem}.provenance{grid-template-columns:1fr}.provenance dd{margin-bottom:.4rem}.executive{padding:1.2rem}.executive-text{font-size:1.06rem}}
</style>
