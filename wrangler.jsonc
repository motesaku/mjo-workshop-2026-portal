// Committed TEMPLATE for forks and fresh clones.
// Do NOT put production D1 UUIDs, account IDs, or live site URLs here.
//
// Owner / existing deployers: copy this file to `wrangler.site.jsonc` (gitignored),
// fill in your own Cloudflare resource IDs and EMDASH_SITE_URL, then use
// `npm run build` / `npm run deploy`. The build reads wrangler.site.jsonc in place
// (this template is never overwritten); deploy refuses to run without it.
// See docs/FORKING.md and docs/PHASE7_DEPLOYMENT_GUIDE.md.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mjo-workshop-2026-portal",
	"main": "./src/worker.ts",
	// Keep at or after 2025-04-01 so Worker secrets reach process.env (EmDash requirement).
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// New deployments start WITHOUT a public hostname: on an empty database the first
	// visitor to finish the setup wizard becomes admin. Enable workers_dev only after
	// Cloudflare Access protects the Worker (docs/PHASE7_DEPLOYMENT_GUIDE.md §4a).
	"workers_dev": false,
	"preview_urls": false,

	// Binding names MUST match astro.config.mjs: d1({ binding: "DB" }), r2({ binding: "MEDIA" }).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mjo-workshop-2026-portal"
			// After `npx wrangler d1 create mjo-workshop-2026-portal`, set:
			// "database_id": "<your-d1-uuid>"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "mjo-workshop-2026-portal-media"
			// Approved site assets only. Never videos or original research documents.
			// EmDash writes JSON backups under backups/: never expose a public bucket domain.
		}
	],

	"triggers": { "crons": ["* * * * *"] },
	"images": { "binding": "IMAGES" },

	"vars": {
		// Set to YOUR Worker origin BEFORE the EmDash setup wizard (passkeys bind to it).
		// "EMDASH_SITE_URL": "https://YOUR-SUBDOMAIN.workers.dev"
	},

	"observability": { "enabled": true }
}
